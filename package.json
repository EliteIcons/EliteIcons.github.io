    "build": "pnpm generate && pnpm build:pkg && pnpm build:docs"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "svgo": "^3.3.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
